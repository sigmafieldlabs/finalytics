{
  "name": "finalytics",
  "version": "1.0.0-alpha.0",
  "description": "Portfolio analytics: accounting, performance, risk, optimisation and reports, compiled to WebAssembly.",
  "license": "MIT OR Apache-2.0",
  "author": "Nnamdi Olisaeloka <nnamdi@sigmafieldlabs.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigmafieldlabs/finalytics.git",
    "directory": "bindings/wasm"
  },
  "homepage": "https://sigmafield.app/libraries/finalytics",
  "bugs": "https://github.com/sigmafieldlabs/finalytics/issues",
  "keywords": [
    "finance",
    "portfolio",
    "optimization",
    "risk",
    "performance",
    "webassembly"
  ],
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "finalytics.d.ts",
  "files": [
    "finalytics_bg.wasm",
    "finalytics_bg.wasm.d.ts",
    "finalytics.js",
    "finalytics.d.ts",
    "index.js",
    "datasets.js",
    "reports.js",
    "data/sp500/prices.csv",
    "data/sp500/index.csv",
    "node.js",
    "worker.js",
    "client.js",
    "client.d.ts",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "./index.js",
    "./node.js",
    "./datasets.js",
    "./reports.js"
  ],
  "exports": {
    ".": {
      "types": "./finalytics.d.ts",
      "node": "./node.js",
      "default": "./index.js"
    },
    "./worker.js": "./worker.js",
    "./client.js": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./finalytics_bg.wasm": "./finalytics_bg.wasm"
  }
}
