"""Type information for the native extension.

The extension is an internal layer: structured values cross as JSON text and series as
little-endian buffers. Use the public API in :mod:`finalytics` instead.
"""

class EngineError(ValueError):
    """An error from the engine: the message, and the issues of a validation error as JSON."""

