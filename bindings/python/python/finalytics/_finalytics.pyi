"""Type information for the native extension.

The extension is an internal layer: structured values cross as JSON text and series as
little-endian buffers. Use the public API in :mod:`finalytics` instead.
"""

class EngineError(ValueError):
    """An error from the engine: the message, and the issues of a validation error as JSON."""

class Market:
    def __init__(self) -> None: ...
    def with_prices(self, id: str, dates_buffer: bytes, values: str) -> Market: ...
    def with_fx(self, base: str, quote: str, dates_buffer: bytes, values: str) -> Market: ...
    def with_pivot(self, pivot: str) -> Market: ...
    def with_max_carry_days(self, days: int) -> Market: ...
    def pivot(self) -> str: ...
    def max_carry_days(self) -> int: ...
    def price(self, id: str, on: str) -> str | None: ...
    def fx_rate(self, base: str, quote: str, on: str) -> str | None: ...
    def prices(self) -> str: ...
    def fx(self) -> str: ...
    def price_dates(self) -> bytes: ...

class NativeBooks:
    def __init__(self, portfolio: str, market: Market) -> None: ...
    def base_currency(self) -> str: ...
    def holdings(self, on: str | None) -> str: ...
    def valuation(self, on: str) -> str: ...
    def value_series(self, dates_buffer: bytes) -> str: ...
    def holding_series(self, dates_buffer: bytes) -> str: ...
    def realised_gains(self) -> str: ...
    def events(self) -> str: ...
    def performance(self, dates_buffer: bytes, timing: str) -> NativePerformance: ...
    def holding_weights(self, on: str) -> str: ...
    def holding_returns(self, holdings: str, dates_buffer: bytes) -> str: ...
    def lots_for_sale(self, on: str, account: str, id: str, quantity: str, method: str) -> str: ...
    def rebalance(self, on: str, account: str, targets: str, options: str) -> str: ...
    def rebalance_accounts(self, on: str, accounts: str, targets: str, options: str) -> str: ...

class NativePerformance:
    @staticmethod
    def from_values(dates_buffer: bytes, values: bytes, flows: bytes, timing: str) -> NativePerformance: ...
    def dates(self) -> bytes: ...
    def returns(self) -> bytes: ...
    def growth(self) -> bytes: ...
    def values(self) -> bytes: ...
    def warnings(self) -> str: ...
    def time_weighted(self, start: str, end: str) -> float | None: ...
    def period(self, period: str, as_of: str | None) -> str | None: ...
    def money_weighted(self, start: str, end: str) -> float | None: ...
    def modified_dietz(self, start: str, end: str) -> float | None: ...
    def excess_return(
        self, period: str, as_of: str | None, benchmark_dates: bytes, benchmark_levels: bytes, max_carry_days: int
    ) -> str | None: ...
    def contributions(self, start: str, end: str) -> str: ...

def version() -> str:
    """Return the version of the Finalytics engine, for example ``"1.0.0"``."""

